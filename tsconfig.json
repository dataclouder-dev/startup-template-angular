/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "paths": {
      "src/*": ["./src/*"],
      "@dataclouder/ngx-agent-cards": ["libs/ngx-dataclouder/ngx-agent-cards/src/public-api.ts"],
      "@dataclouder/ngx-agentic-chat": ["libs/ngx-dataclouder/ngx-agentic-chat/src/public-api.ts"],
      "@dataclouder/ngx-ai-services": ["libs/ngx-dataclouder/ngx-ai-services/src/public-api.ts"],
      "@dataclouder/ngx-analytics": ["libs/ngx-dataclouder/ngx-analytics/src/public-api.ts"],
      "@dataclouder/ngx-auth": ["libs/ngx-dataclouder/ngx-auth/src/public-api.ts"],
      "@dataclouder/ngx-cloud-storage": ["libs/ngx-dataclouder/ngx-cloud-storage/src/public-api.ts"],
      "@dataclouder/ngx-core": ["libs/ngx-dataclouder/ngx-core/src/public-api.ts"],
      "@dataclouder/ngx-deck": ["libs/ngx-dataclouder/ngx-deck/src/public-api.ts"],
      "@dataclouder/ngx-knowledge": ["libs/ngx-dataclouder/ngx-knowledge/src/public-api.ts"],
      "@dataclouder/ngx-lessons": ["libs/ngx-dataclouder/ngx-lessons/src/public-api.ts"],
      "@dataclouder/ngx-mic": ["libs/ngx-dataclouder/ngx-mic/src/public-api.ts"],
      "@dataclouder/ngx-payment": ["libs/ngx-dataclouder/ngx-payment/src/public-api.ts"],
      "@dataclouder/ngx-theatre": ["libs/ngx-dataclouder/ngx-theatre/src/public-api.ts"],
      "@dataclouder/ngx-theatre/3d": ["libs/ngx-dataclouder/ngx-theatre/3d/src/public-api.ts"],
      "@dataclouder/ngx-tour": ["libs/ngx-dataclouder/ngx-tour/src/public-api.ts"],
      "@dataclouder/ngx-ui-context": ["libs/ngx-dataclouder/ngx-ui-context/src/public-api.ts"],
      "@dataclouder/ngx-users": ["libs/ngx-dataclouder/ngx-users/src/public-api.ts"]
    },
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "es2022",
    "module": "es2020",
    "lib": ["es2022", "dom"],
    "useDefineForClassFields": false, 
    "skipLibCheck": true
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
