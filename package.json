{
  "name": "dataclouder-template",
  "config": {
    "appId": "dev.dataclouder.template",
    "appIdDev": "dev.dataclouder.template.dev"
  },
  "version": "0.0.40",
  "author": "Dataclouder",
  "homepage": "dataclouder.dev",
  "scripts": {
    "ng": "ng",
    "config:dev": "cp public/config.dev.json public/config.json",
    "config:prod": "cp public/config.prod.json public/config.json",
    "config:ailab": "cp public/config.ailab.json public/config.json",
    "config:homelab": "cp public/config.homelab.json public/config.json",
    "config:internalnet": "cp public/config.internalnet.json public/config.json",
    "start": "npm run config:dev && ng serve --host 0.0.0.0 --port 7990",
    "start:qa": "npm run config:dev && ng serve -c qa --host 0.0.0.0 --port 7990",
    "start:prod": "npm run config:prod && ng serve -c production --host 0.0.0.0 --port 7990",
    "prebuild": "pnpm version patch --no-git-tag-version && npm run sync-version",
    "build": "ng build",
    "build:dev": "npm run config:dev && ng build",
    "build:prod": "npm run config:prod && ng build -c production",
    "build:internalnet": "npm run config:internalnet && ng build",
    "sync-version": "node scripts/sync-version.js",
    "deploy-prod-local": "ng build -c production & npx serve -s www/browser",
    "watch": "ng build --watch --configuration development",
    "update:dc": "pnpm install @dataclouder/ngx-auth@latest @dataclouder/ngx-agent-cards@latest @dataclouder/ngx-lessons@latest @dataclouder/ngx-cloud-storage@latest @dataclouder/ngx-core@latest @dataclouder/ngx-mic@latest @dataclouder/ngx-tts@latest @dataclouder/ngx-ai-services@latest @dataclouder/ngx-users@latest @dataclouder/ngx-logs@latest @dataclouder/ngx-knowledge@latest",
    "deploy": "npm run build && firebase deploy --only hosting:dataclouder-dev",
    "ios:dev": "npm run config:dev && ng build -c development && cap copy ios && npx cap run ios",
    "ios:prod": "npm run config:prod && ng build -c production && cap copy ios && npx cap run ios --configuration Release",
    "ios:dev-sim": "npm run config:dev && ng build -c development && cap copy ios && npx cap run ios --target 3FFDE946-E48B-4215-A7CD-D7C1872FDAF2",
    "android:debug": "ionic cap run android -l --external",
    "android:run": "npx cap run android",
    "android:open": "npx cap open android",
    "android:install-dev": "npm run config:dev && ng build -c development && cap copy android && cd android && ./gradlew assembleDev && adb install app/build/outputs/apk/dev/app-dev.apk && adb shell monkey -p dev.dataclouder.template.dev -c android.intent.category.LAUNCHER 1",
    "android:install-pro": "npm run config:prod && ng build -c production && cap copy android && cd android && ./gradlew assembleRelease && adb install app/build/outputs/apk/release/app-release.apk && adb shell monkey -p ${npm_package_config_appId} -c android.intent.category.LAUNCHER 1",
    "test": "ng test",
    "lint": "ng lint",
    "storybook": "ng run app:storybook",
    "build-storybook": "ng run app:build-storybook"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~21.2.11",
    "@angular/cdk": "~21.2.9",
    "@angular/common": "~21.2.11",
    "@angular/compiler": "~21.2.11",
    "@angular/core": "~21.2.11",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "~21.2.11",
    "@angular/platform-browser": "~21.2.11",
    "@angular/platform-browser-dynamic": "~21.2.11",
    "@angular/router": "~21.2.11",
    "@angular/service-worker": "~21.2.11",
    "@capacitor-community/apple-sign-in": "7.1.0",
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "7.1.0",
    "@capacitor/core": "7.4.4",
    "@capacitor/haptics": "7.0.2",
    "@capacitor/ios": "7.4.4",
    "@capacitor/keyboard": "7.0.3",
    "@capacitor/status-bar": "7.0.3",
    "@ckeditor/ckeditor5-angular": "^6.0.1",
    "@ckeditor/ckeditor5-build-balloon-block": "^38.1.0",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@dataclouder/ngx-agent-cards": "^0.2.8",
    "@dataclouder/ngx-ai-services": "^0.0.56",
    "@dataclouder/ngx-auth": "^0.0.47",
    "@dataclouder/ngx-cloud-storage": "^0.0.38",
    "@dataclouder/ngx-core": "^0.2.10",
    "@dataclouder/ngx-knowledge": "^0.0.1",
    "@dataclouder/ngx-lessons": "^0.1.25",
    "@dataclouder/ngx-logs": "^0.0.2",
    "@dataclouder/ngx-mic": "^0.1.4",
    "@dataclouder/ngx-tts": "^0.0.2",
    "@dataclouder/ngx-users": "^0.0.24",
    "@ionic/angular": "^8.7.10",
    "@jcesarmobile/ssl-skip": "0.4.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@primeng/themes": "^21.0.2",
    "@primeuix/themes": "^2.0.2",
    "@ricky0123/vad-web": "^0.0.30",
    "@tailwindcss/postcss": "^4.1.4",
    "angular-shepherd": "^20.0.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.2.1",
    "es-toolkit": "^1.41.0",
    "firebase": "^12.7.0",
    "ionicons": "^8.0.13",
    "ngx-image-cropper": "^9.1.5",
    "ngx-markdown": "^21.0.1",
    "npm-check-updates": "^17.1.16",
    "plyr": "^3.8.3",
    "postcss": "^8.5.3",
    "primeicons": "^7.0.0",
    "primeng": "^21.0.2",
    "rxjs": "~7.8.2",
    "shepherd.js": "^14.5.1",
    "swiper": "^11.2.10",
    "tailwindcss": "^4.1.4",
    "tslib": "^2.8.1",
    "turndown": "^7.2.0",
    "vis-data": "^8.0.3",
    "vis-network": "^10.0.1",
    "vis-timeline": "^8.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~21.2.9",
    "@angular-eslint/builder": "^21.3.1",
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular-eslint/eslint-plugin-template": "^21.3.1",
    "@angular-eslint/schematics": "^21.3.1",
    "@angular-eslint/template-parser": "^21.3.1",
    "@angular/build": "^21.0.4",
    "@angular/cli": "~21.0.4",
    "@angular/compiler-cli": "~21.2.11",
    "@angular/language-service": "~21.2.11",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "7.4.4",
    "@compodoc/compodoc": "^1.1.32",
    "@ionic/angular-toolkit": "^12.3.0",
    "@storybook/addon-docs": "^10.0.4",
    "@storybook/addon-onboarding": "^10.0.4",
    "@storybook/angular": "^10.0.4",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-prefer-arrow": "1.2.2",
    "eslint-plugin-storybook": "^10.0.4",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.3",
    "storybook": "^10.0.4",
    "typescript": "~5.9.3"
  },
  "description": "An Ionic project"
}
